#include "resource.h"
#include <winver.h>

IDI_APPICON ICON "..\\assets\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
 FILEFLAGS       0x1L
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LocalAI Inc."
            VALUE "FileDescription",  "Local AI Agent"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "LocalAIAgent.exe"
            VALUE "OriginalFilename", "LocalAIAgent.exe"
            VALUE "ProductName",      "Local AI Agent"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "(c) 2026 LocalAI Inc."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
